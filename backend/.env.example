# Mnema Backend Environment Configuration Example
# Copy this file to a new file named '.env' in this directory.

# Google Gemini API key used for RAG embeddings and generation
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Comma-separated list of origins allowed by CORS.
# In production, set this to your deployed frontend domain (e.g. https://mnema-98.vercel.app)
# Fallback during local development is http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
